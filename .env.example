# Local SQLite database
DATABASE_URL="file:./db/custom.db"

# Replace these values outside local development
ORG_SIGNING_KEY="replace-with-a-long-random-secret"
KEY_ID="k1"

# Internal real-time alert service
ALERTS_SERVICE_URL="http://localhost:3003/emit"

# Runtime profile. Demo routes are disabled by default and can never be enabled
# when this value is "production".
DEPLOYMENT_STAGE="development"
DEMO_MODE="false"
